# Environment Variables Example

# Server configuration
PORT=5000
NODE_ENV=development

# Neon PostgreSQL Connection URL
# Replace with your actual Neon database connection string
DATABASE_URL="postgresql://username:password@ep-sample-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Secret
JWT_SECRET="operations-super-secret-jwt-key-2026-distribution"
JWT_EXPIRES_IN="7d"

# Frontend URL for CORS
CLIENT_URL="http://localhost:5173"
