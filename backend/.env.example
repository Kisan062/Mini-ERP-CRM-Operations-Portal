# Environment Variables Example

# Server configuration
PORT=5000
NODE_ENV=development

# MySQL Database Connection URL (e.g. local MySQL or cloud MySQL like TiDB / Aiven / PlanetScale)
DATABASE_URL="mysql://root:password@localhost:3306/mini_erp"

# JWT Secret
JWT_SECRET="operations-super-secret-jwt-key-2026-distribution"
JWT_EXPIRES_IN="7d"

# Frontend URL for CORS
CLIENT_URL="http://localhost:5173"
